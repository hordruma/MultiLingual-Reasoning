# Copy to .env and fill in only the providers you intend to use.
# run_experiment.py loads this file automatically (python-dotenv).
#   python run_experiment.py --list        # model → env var mapping
#   python run_experiment.py --smoke-test  # verify each key with one tiny call

# ── Default cheap tier ───────────────────────────────────────────────
# OpenAI: gpt-5.6-luna
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google: gemini-3.1-flash-lite (and gemini-2.5-flash-lite), OpenAI-compatible layer
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# DeepSeek: deepseek-v4-flash
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Alibaba Model Studio / DashScope: qwen3.7-flash
# International (Singapore) endpoint is the default; mainland accounts use
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Z.ai: glm-5.3-flash
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# MiniMax (international platform): MiniMax-M3
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# ── Opt-in cloud ─────────────────────────────────────────────────────
# Anthropic: claude-haiku (Haiku 4.5), claude-sonnet (Sonnet 5)
ANTHROPIC_API_KEY=

# Mistral: mistral-small
MISTRAL_API_KEY=

# TokenRouter: OpenAI-compatible aggregator, GLM-5.3 free at time of writing.
# Use with --models tokenrouter; list ids with --remote-models tokenrouter
TOKENROUTER_API_KEY=
# TOKENROUTER_MODEL=z-ai/glm-5.3-free
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# OpenRouter: one key, any model id; use with --models openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Local inference (no key needed) ──────────────────────────────────
# Ollama: `ollama pull qwen3.5:9b` then --models ollama --concurrency 1
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# LM Studio: start the server, load a model, then --models lmstudio
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Any other OpenAI-compatible host (vLLM, Azure AI Foundry, ...): point one
# of the *_BASE_URL variables at it. The URL is the prefix to which
# "/chat/completions" is appended.
