# Copy to .env and fill in only the providers you intend to use.
# run_experiment.py loads this file automatically (python-dotenv).
# Every model in config.MODELS names the env vars it reads; run
#   python run_experiment.py --list        # see model → env var mapping
#   python run_experiment.py --smoke-test  # verify each key with one tiny call

# ── OpenAI (gpt-4o-mini, gpt-4o) ─────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic (claude-haiku, claude-sonnet) ─────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini via its OpenAI-compatible endpoint ─────────────────
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── DeepSeek direct ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Mistral direct ───────────────────────────────────────────────────
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Alibaba DashScope (qwen-plus, qwen-max) ──────────────────────────
# International endpoint is the default; mainland-China accounts use
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── OpenRouter: optional single-key route to many models ─────────────
# Use with `--models openrouter`; pick the model with OPENROUTER_MODEL.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Azure AI Foundry / any other OpenAI-compatible host ──────────────
# Point any model's *_BASE_URL at the host and put the key in its *_API_KEY.
# The URL must be the prefix to which "/chat/completions" is appended.
